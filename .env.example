# Nautilus 环境变量模板
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必更换为强随机字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT 过期时间
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 数据库路径（相对于 server 目录）
DB_PATH=./db/nautilus.db

# 运行环境
NODE_ENV=development

# 允许的前端域名（CORS 白名单，逗号分隔）
ALLOWED_ORIGINS=http://localhost:9527

# 阿里云视觉智能开发平台（用于抠图等服务）
# 建议使用 RAM 子账号 + 最小权限策略
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 阿里云百炼 / DashScope（用于语音合成与声音复刻，仅后端读取）
DASHSCOPE_API_KEY=
# 可选：业务空间专属域名，例如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 阿里云 OSS（用于 CosyVoice 复刻音频临时中转）
OSS_REGION=oss-cn-beijing
OSS_BUCKET=nautilus-audio
OSS_PREFIX=nautilus/voice-lab/
OSS_SIGN_URL_EXPIRES_SECONDS=1800
OSS_CLEANUP_AFTER_CLONE=true

# 首页 AI 新闻源
# hybrid: 优先 RSS，失败时回退飞书 Base；rss: 仅 RSS；lark: 仅飞书 Base
NEWS_SOURCE=hybrid
NEWS_RSS_URL=https://llmposts.com/feed/
NEWS_REFRESH_MINUTES=60
NEWS_REQUEST_TIMEOUT_MS=8000

# hetao-cli 数据源（BTC 课程进量看板 POC）
# 默认调用 PATH 中的 hetao-cli；如服务进程 PATH 不含 CLI，可填绝对路径
HETAO_CLI_BIN=hetao-cli
HETAO_CLI_PROFILE=
HETAO_CLI_TIMEOUT_MS=30000
